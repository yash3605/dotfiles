            "format": "   \u001b[38;2;247;118;142m⬤\u001b[0m  \u001b[38;2;255;158;100m⬤\u001b[0m  \u001b[38;2;224;175;104m⬤\u001b[0m  \u001b[38;2;158;206;106m⬤\u001b[0m  \u001b[38;2;122;162;247m⬤\u001b[0m  \u001b[38;2;187;154;247m⬤\u001b[0m  \u001b[38;2;125;207;255m⬤\u001b[0m"
