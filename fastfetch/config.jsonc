{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch3",
        "color": {
            "1": "38;2;122;162;247",
            "2": "38;2;187;154;247"
        },
        "padding": {
            "top": 1,
            "right": 6,
            "left": 1
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "title",
            "userNameColor": "38;2;122;162;247",
            "atColor": "38;2;65;72;104",
            "hostNameColor": "38;2;187;154;247",
            "key": " ",
            "keyColor": "38;2;122;162;247"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;30;32;52m  ────────────────────────────────\u001b[0m"
        },
        {
            "type": "os",
            "key": "  os      ",
            "keyColor": "38;2;122;162;247"
        },
        {
            "type": "kernel",
            "key": "  kernel  ",
            "keyColor": "38;2;122;162;247"
        },
        {
            "type": "packages",
            "key": "󰏖  pkgs    ",
            "keyColor": "38;2;122;162;247"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;30;32;52m  ────────────────────────────────\u001b[0m"
        },
        {
            "type": "wm",
            "key": "  wm      ",
            "keyColor": "38;2;187;154;247"
        },
        {
            "type": "terminal",
            "key": "  term    ",
            "keyColor": "38;2;187;154;247"
        },
        {
            "type": "shell",
            "key": "  shell   ",
            "keyColor": "38;2;187;154;247"
        },
        {
            "type": "uptime",
            "key": "󰅐  uptime  ",
            "keyColor": "38;2;187;154;247"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;30;32;52m  ────────────────────────────────\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "  cpu     ",
            "keyColor": "38;2;125;207;255"
        },
        {
            "type": "gpu",
            "key": "󰍛  gpu     ",
            "keyColor": "38;2;125;207;255"
        },
        {
            "type": "memory",
            "key": "  memory  ",
            "keyColor": "38;2;158;206;106"
