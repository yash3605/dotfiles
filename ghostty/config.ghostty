font-family = GeistMono Nerd Font
font-size = 13

background = 0a0a0f
foreground = cdd6f4
cursor-color = cdd6f4

palette = 0=#1e1e2e
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#cba6f7
palette = 6=#89dceb
palette = 7=#cdd6f4
palette = 8=#45475a
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#cba6f7
palette = 14=#89dceb
palette = 15=#cdd6f4
background-opacity = 0.85
background-blur-radius = 20

cursor-style = bar
cursor-style-blink = true

window-padding-x = 12
window-padding-y = 12

shell-integration = fish

scrollback-limit = 10000
